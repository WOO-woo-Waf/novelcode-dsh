# Absolute path to the read-only Novel Workbench source checkout that provides
# the existing Narrative V2 JSONL service. Do not point this at a live novel workspace.
NOVELCODE_DSH_CORE_ROOT=/absolute/path/to/novel-workbench

# Bun executable used only for the Narrative V2 sidecar.
NOVELCODE_DSH_BUN_EXECUTABLE=bun

# Optional explicit service entry. Defaults to
# <NOVELCODE_DSH_CORE_ROOT>/apps/novelcode/packages/narrative/src/service.ts.
# NOVELCODE_DSH_SERVICE_ENTRY=/absolute/path/to/service.ts

# Milliseconds before a sidecar request is rejected.
NOVELCODE_DSH_REQUEST_TIMEOUT_MS=120000

# Maximum stderr bytes retained per workspace for readiness diagnostics.
NOVELCODE_DSH_STDERR_LIMIT_BYTES=16384

# Optional DSH native Skill root. Point this at the packaged directory reported
# by `pnpm noveldsh assets`; it contains process instructions, never novel canon.
# DSH_BUNDLED_SKILL_DIR=/absolute/path/to/packages/dsh-novel-author/skills
